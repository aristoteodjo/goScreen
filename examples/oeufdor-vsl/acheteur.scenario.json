{
  "version": 1,
  "name": "OEUF D'OR acheteur",
  "url": "https://oeufsdor.vercel.app/",
  "device": { "id": "galaxy-s25", "color": "navy" },
  "locale": "fr-FR",
  "timezone": "Africa/Porto-Novo",
  "vars": {
    "buyerPhone": { "label": "Numéro de l'acheteur de test" },
    "producerPhone": { "label": "Numéro du producteur (valide la remise hors caméra)" },
    "payPhone": { "label": "Numéro Mobile Money FedaPay (bac à sable)", "default": "0166000001" },
    "zone": { "label": "Zone choisie sur l'accueil", "default": "Kpota, Calavi" },
    "seller": { "label": "Producteur (texte de sa carte d'offre)", "default": "Ferme Or" }
  },
  "mask": ["^(Développement|Environnement de test)\\s*:"],
  "film": {
    "aspect": "9:16",
    "background": "#f7f7f2",
    "ink": "#16241c",
    "accent": "#e9a100",
    "font": "Avenir Next",
    "captions": "top",
    "zoom": 1.35,
    "intro": { "title": "Vous cherchez des œufs ? Voyez qui en a.", "subtitle": "Votre numéro WhatsApp suffit. Vous payez OEUF D'OR, pas le vendeur.", "duration": 3 },
    "outro": { "title": "Trouvez. Payez. Recevez.", "subtitle": "Vos commandes et vos tickets au même endroit.", "duration": 3.2 }
  },
  "steps": [
    { "do": "scene", "caption": "Des œufs près de chez vous ?" },
    { "do": "wait", "ms": 3200 },

    { "do": "scene", "caption": "Votre produit, votre quartier" },
    { "do": "scroll", "by": 380, "duration": 900 },
    { "do": "tap", "target": { "css": "#hero-zone" } },
    { "do": "tap", "target": { "role": "option", "name": "{{zone}}" } },
    { "do": "tap", "target": { "role": "button", "name": "Voir qui en a" } },
    { "do": "waitUrl", "match": "/offres" },
    { "do": "wait", "ms": 600 },

    { "do": "scene", "caption": "Le vrai stock, en temps réel" },
    { "do": "wait", "ms": 1200 },
    { "do": "scroll", "to": { "css": "a[href^='/offres/']", "hasText": "{{seller}}" }, "duration": 1800 },
    { "do": "wait", "ms": 1000 },
    { "do": "tap", "target": { "css": "a[href^='/offres/']", "hasText": "{{seller}}" } },
    { "do": "waitUrl", "match": "/offres/.+" },

    { "do": "scene", "caption": "Choisissez la quantité" },
    { "do": "wait", "ms": 1200 },
    { "do": "scroll", "to": { "role": "button", "name": "Ajouter un" } },
    { "do": "tap", "target": { "role": "button", "name": "Ajouter un" }, "repeat": 9 },
    { "do": "tap", "target": { "css": "#order-pickup" } },
    { "do": "wait", "ms": 900 },

    { "do": "scene", "caption": "Juste votre numéro WhatsApp" },
    { "do": "type", "target": { "css": "input[type=tel]" }, "text": "{{buyerPhone}}" },
    { "do": "tap", "target": { "role": "button", "name": "Recevoir mon code" } },
    { "do": "wait", "ms": 900 },
    { "do": "type", "text": "{{code}}", "delay": 170 },
    { "do": "wait", "ms": 900 },

    { "do": "scene", "caption": "Votre stock est réservé" },
    { "do": "scroll", "to": { "role": "button", "name": "Envoyer ma commande" } },
    { "do": "wait", "ms": 700 },
    { "do": "tap", "target": { "role": "button", "name": "Envoyer ma commande" } },
    { "do": "waitUrl", "match": "/commandes/.+", "timeout": 40000 },
    { "do": "remember", "name": "order", "match": "/commandes/([A-Z0-9-]+)" },
    { "do": "wait", "ms": 2500 },

    { "do": "scene", "caption": "Vous payez OEUF D'OR, pas le vendeur" },
    { "do": "wait", "ms": 1500 },
    { "do": "tap", "target": { "role": "button", "name": "Payer ·" } },
    { "do": "waitFor", "target": { "frame": "iframe[src*='fedapay']", "css": "a:visible", "hasText": "Mobile Money" }, "timeout": 30000 },
    { "do": "wait", "ms": 1200 },
    { "do": "tap", "target": { "frame": "iframe[src*='fedapay']", "css": "a:visible", "hasText": "Mobile Money" } },
    { "do": "waitFor", "target": { "frame": "iframe[src*='fedapay']", "css": "#phone_number" } },
    { "do": "check", "target": { "frame": "iframe[src*='fedapay']", "css": "#sendReceipt" }, "value": false },
    { "do": "type", "target": { "frame": "iframe[src*='fedapay']", "css": "#phone_number" }, "text": "{{payPhone}}", "clear": true },
    { "do": "tap", "target": { "frame": "iframe[src*='fedapay']", "css": "button[type=submit]:visible" } },
    { "do": "wait", "ms": 4000 },
    { "do": "cut" },
    { "do": "waitFor", "target": { "text": "Code de remise", "exact": true }, "timeout": 120000 },

    { "do": "scene", "caption": "Votre code de remise" },
    { "do": "wait", "ms": 1500 },
    { "do": "scroll", "by": 300, "duration": 1500 },
    { "do": "wait", "ms": 1500 },
    { "do": "remember", "name": "pickup", "target": { "css": "div", "hasText": "Code de remise", "nth": -1 }, "match": "Code de remise\\s+([A-Z0-9-]+)" },
    { "do": "scene", "caption": "Commande en main ? Donnez le code" },
    { "do": "scroll", "by": 400, "duration": 1500 },
    { "do": "wait", "ms": 1800 },
    { "do": "cut" },

    { "do": "session", "name": "producteur" },
    { "do": "goto", "url": "https://oeufsdor-pro.vercel.app/login" },
    { "do": "type", "target": { "css": "input[type=tel]" }, "text": "{{producerPhone}}" },
    { "do": "tap", "target": { "role": "button", "name": "Recevoir le code" } },
    { "do": "type", "text": "{{code}}", "delay": 120 },
    { "do": "tap", "target": { "role": "button", "name": "Se connecter" } },
    { "do": "waitUrl", "match": "/producer/?$", "timeout": 30000 },
    { "do": "goto", "url": "https://oeufsdor-pro.vercel.app/producer/orders/{{order}}" },
    { "do": "tap", "target": { "role": "button", "name": "Valider la remise" } },
    { "do": "type", "target": { "css": "#producer-code" }, "text": "{{pickup}}" },
    { "do": "tap", "target": { "role": "button", "name": "Valider la remise", "nth": -1 } },
    { "do": "wait", "ms": 2500 },

    { "do": "session", "name": "main" },
    { "do": "goto", "url": "https://oeufsdor.vercel.app/commandes/{{order}}" },
    { "do": "scene", "caption": "Reçu. Notez le producteur" },
    { "do": "wait", "ms": 1200 },
    { "do": "scroll", "to": { "css": "[aria-label='5 sur 5 : Excellent']" } },
    { "do": "tap", "target": { "css": "[aria-label='5 sur 5 : Excellent']" } },
    { "do": "type", "target": { "css": "#rating-comment" }, "text": "Œufs bien frais, merci" },
    { "do": "tap", "target": { "role": "button", "name": "Envoyer ma note" } },
    { "do": "wait", "ms": 1500 },

    { "do": "scene", "caption": "Tout votre historique" },
    { "do": "tap", "target": { "role": "link", "name": "Mes commandes" } },
    { "do": "waitUrl", "match": "/commandes/?$" },
    { "do": "wait", "ms": 1500 },
    { "do": "goto", "url": "https://oeufsdor.vercel.app/compte" },
    { "do": "scroll", "by": 420, "duration": 1600 },
    { "do": "wait", "ms": 1500 }
  ]
}
